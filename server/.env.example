DATABASE_URL="postgresql://user:password@localhost:5432/olivepinch?schema=public"
JWT_SECRET="change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Optional — leave unset to use dev-mode console logging / auto-succeed instead of real sends
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="OlivePinch <hello@olivepinch.co.uk>"

# Optional — public URL the "complete your account" recovery email should link to
APP_URL="http://localhost:5173"
# Optional — shared secret for POST /api/internal/recovery-sweep (Vercel Cron sends this
# automatically as a Bearer token when CRON_SECRET is set as a project env var). Leave
# unset locally to call the endpoint without auth.
CRON_SECRET=
