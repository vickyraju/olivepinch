DATABASE_URL="postgresql://user:password@localhost:5432/olivepinch?schema=public"
JWT_SECRET="change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Required — customer auth (phone OTP) is handled by Firebase Auth. Generate this in the
# Firebase console under Project Settings > Service Accounts > Generate new private key,
# then paste the full JSON as a one-line string. Without this, every customer-authenticated
# route (dashboard, /customers/me, etc.) 501s — unlike payments/email, there's no dev-mode
# fallback for identity.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — leave unset to use dev-mode console logging / auto-succeed instead of real sends
# Worldpay credentials are issued by a Worldpay Implementation Manager, not self-serve
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_ENTITY=
WORLDPAY_API_URL="https://try.access.worldpay.com"
# Access Checkout SDK checkout ID — not yet consumed by any code, see src/lib/worldpay.ts
WORLDPAY_CHECKOUT_ID=
RESEND_API_KEY=
EMAIL_FROM="OlivePinch <hello@olivepinch.co.uk>"

# Optional — public URL the FR-C26 recovery email and Worldpay's post-payment redirect
# both link back to
APP_URL="http://localhost:5173"
# Required for POST /api/internal/recovery-sweep to run at all (Vercel Cron sends this
# automatically as a Bearer token when CRON_SECRET is set as a project env var). The
# endpoint refuses all requests while this is unset — set it locally to test the sweep.
CRON_SECRET=
