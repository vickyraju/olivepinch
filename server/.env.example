DATABASE_URL="postgresql://user:password@localhost:5432/olivepinch?schema=public"
JWT_SECRET="change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Required — customer auth (email OTP + Google sign-in) is handled by Supabase Auth.
# Same project as DATABASE_URL. Find both in the Supabase dashboard under Project Settings >
# API. Without these, every customer-authenticated route (dashboard, /customers/me, etc.)
# 501s — unlike payments/email, there's no dev-mode fallback for identity.

# Optional — leave unset to use dev-mode console logging / auto-succeed instead of real sends
# Worldpay credentials are issued by a Worldpay Implementation Manager, not self-serve
WORLDPAY_USERNAME=
WORLDPAY_PASSWORD=
WORLDPAY_ENTITY=
WORLDPAY_API_URL="https://try.access.worldpay.com"
# Access Checkout SDK checkout ID — not yet consumed by any code, see src/lib/worldpay.ts
WORLDPAY_CHECKOUT_ID=
RESEND_API_KEY=
# Full-access key, only for scripts/resend-templates.mts (never set on the server)
RESEND_ADMIN_API_KEY=
EMAIL_FROM="OlivePinch <hello@olivepinch.com>"

# Optional — public URL the FR-C26 recovery email and Worldpay's post-payment redirect
# both link back to
APP_URL="http://localhost:5173"
# Required for POST /api/internal/recovery-sweep to run at all (Vercel Cron sends this
# automatically as a Bearer token when CRON_SECRET is set as a project env var). The
# endpoint refuses all requests while this is unset — set it locally to test the sweep.
CRON_SECRET=

# Login (Better Auth)
BETTER_AUTH_SECRET=              # 32+ random characters: openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:4000"   # public address of this API, e.g. https://api.example.com
AUTH_COOKIE_DOMAIN=              # production: the root domain, e.g. example.com (shares the login cookie across subdomains)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Menu photos are stored on this server's disk
UPLOAD_DIR="./uploads"
UPLOADS_PUBLIC_URL="http://localhost:4000/uploads"
