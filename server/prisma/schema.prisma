generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  WEIGHT_MAINTENANCE
  MUSCLE_BUILDING
}

enum DietType {
  MEAT
  FISH
  VEGAN
  VEGETARIAN
  EGG
}

enum AccountStatus {
  PROVISIONAL
  ACTIVE
  READ_ONLY
  DELETED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum OrderStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  ATTEMPTED
  PAUSED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

model Customer {
  id              String        @id @default(cuid())
  fullName        String
  email           String        @unique
  passwordHash    String?
  gender          String?
  age             Int?
  heightCm        Float?
  weightKg        Float?
  goal            Goal?
  dietType        DietType?
  allergens       String[]      @default([])
  postcode        String?
  address         String?
  marketingOptIn  Boolean       @default(false)
  accountStatus   AccountStatus @default(PROVISIONAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  consentLogs     ConsentLog[]
  subscriptions   Subscription[]
  healthLogs      HealthLog[]
  payments        Payment[]
  notifications   Notification[]
  otps            Otp[]
}

model ConsentLog {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consentType  String
  granted      Boolean
  version      String
  timestamp    DateTime @default(now())
}

model Subscription {
  id            String              @id @default(cuid())
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planDuration  Int
  startDate     DateTime            @db.Date
  mealsPerDay   Int
  status        SubscriptionStatus  @default(PENDING_PAYMENT)
  pausedDates   DateTime[]          @default([]) @db.Date
  createdAt     DateTime            @default(now())

  orders        Order[]
  payments      Payment[]
}

model HealthLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  heightCm   Float
  weightKg   Float
  chestCm    Float
  bicepCm    Float
  abdomenCm  Float
  waistCm    Float
  loggedAt   DateTime @default(now())
}

model MenuItem {
  id            String      @id @default(cuid())
  name          String
  description   String
  photoUrl      String?
  slot          MealSlot
  dietTags      DietType[]
  allergenTags  String[]    @default([])
  goalTags      Goal[]
  kcal          Int
  protein       Int
  price         Decimal     @db.Decimal(6, 2)
  premium       Boolean     @default(false)
  dailyCapacity Int?

  orderItems    OrderItem[]
}

model Order {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime     @db.Date
  status         OrderStatus  @default(SCHEDULED)

  items          OrderItem[]

  @@unique([subscriptionId, deliveryDate])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  slot       MealSlot
}

model Payment {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Decimal       @db.Decimal(8, 2)
  status         String
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

model Zone {
  id               String   @id @default(cuid())
  name             String
  postcodePrefixes String[]
  isActive         Boolean  @default(true)
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  postcode  String
  createdAt DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String
  message    String
  status     String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Otp {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  auditLogs    AdminAuditLog[]
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  customerId String?
  detail     String?
  createdAt  DateTime  @default(now())
}
