generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  WEIGHT_MAINTENANCE
  MUSCLE_BUILDING
}

enum DietType {
  MEAT
  FISH
  VEGAN
  VEGETARIAN
  EGG
}

enum AccountStatus {
  PROVISIONAL
  ACTIVE
  READ_ONLY
  DELETED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
}

enum DeliverySlot {
  DAILY
  WEEKLY
  ALTERNATE
}

enum OrderStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  ATTEMPTED
  PAUSED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

model Customer {
  id              String        @id @default(cuid())
  fullName        String
  email           String        @unique
  supabaseUserId  String?       @unique
  passwordHash    String?
  gender          String?
  dateOfBirth     DateTime?     @db.Date
  heightCm        Float?
  weightKg        Float?
  goal            Goal?
  dietTypes       DietType[]    @default([])
  allergens       String[]      @default([])
  postcode        String?
  addressDoorNumber   String?
  addressBuildingName String?
  addressStreet       String?
  addressArea         String?
  addressPostcode     String?
  marketingOptIn  Boolean       @default(false)
  accountStatus   AccountStatus @default(PROVISIONAL)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  consentLogs     ConsentLog[]
  subscriptions   Subscription[]
  healthLogs      HealthLog[]
  payments        Payment[]
  notifications   Notification[]
  otps            Otp[]
}

model ConsentLog {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  consentType  String
  granted      Boolean
  version      String
  timestamp    DateTime @default(now())
}

model Subscription {
  id            String              @id @default(cuid())
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planDuration  Int
  startDate     DateTime            @db.Date
  mealsPerDay   Int
  status        SubscriptionStatus  @default(PENDING_PAYMENT)
  pausedDates   DateTime[]          @default([]) @db.Date
  deliverySlot  DeliverySlot        @default(DAILY)
  createdAt     DateTime            @default(now())

  orders        Order[]
  payments      Payment[]
}

model HealthLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  heightCm   Float
  weightKg   Float
  chestCm    Float
  bicepCm    Float
  abdomenCm  Float
  waistCm    Float
  loggedAt   DateTime @default(now())
}

model MenuItem {
  id            String      @id @default(cuid())
  name          String
  description   String
  photoUrl      String?
  slot          MealSlot
  dietTags      DietType[]
  allergenTags  String[]    @default([])
  goalTags      Goal[]
  kcal          Int
  protein       Int
  price         Decimal     @db.Decimal(6, 2)
  premium       Boolean     @default(false)
  dailyCapacity Int?

  orderItems    OrderItem[]
  weekItems     MenuWeekItem[]
}

model Order {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime     @db.Date
  status         OrderStatus  @default(SCHEDULED)
  // Set once this order's items reflect an explicit customer (or admin-override) choice for
  // its week, rather than the goal/diet default assigned at plan creation — drives both the
  // dashboard's "choose next week" banner and the admin missed-cutoff list.
  menuChosenAt   DateTime?

  items          OrderItem[]

  @@unique([subscriptionId, deliveryDate])
}

// Shared, business-wide weekly menu cycle: admin drafts/publishes an available-item list for
// a given Monday-start week; customers then edit their existing per-day Order/OrderItem rows
// for that week's dates, constrained to what's published, up to the Friday cutoff.
model MenuWeek {
  id          String         @id @default(cuid())
  weekStart   DateTime       @db.Date
  published   Boolean        @default(false)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())

  items       MenuWeekItem[]

  @@unique([weekStart])
}

model MenuWeekItem {
  id         String   @id @default(cuid())
  menuWeekId String
  menuWeek   MenuWeek @relation(fields: [menuWeekId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([menuWeekId, menuItemId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  slot       MealSlot
}

model Payment {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  amount         Decimal       @db.Decimal(8, 2)
  status         String
  providerRef    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

model Zone {
  id               String   @id @default(cuid())
  name             String
  postcodePrefixes String[]
  isActive         Boolean  @default(true)
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  postcode  String
  createdAt DateTime @default(now())
}

model Notification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel    String
  message    String
  status     String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Otp {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  auditLogs    AdminAuditLog[]
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  customerId String?
  detail     String?
  createdAt  DateTime  @default(now())
}
