<mjml lang="en">
  <mj-head>
    <mj-title>Your OlivePinch plan ends {{endDate}}</mj-title>
    <mj-preview>Renew before then so there's no gap in your deliveries.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#272c0f" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body background-color="#f7f4ec" width="600px">

    <!-- Masthead -->
    <mj-section padding="40px 32px 12px">
      <mj-column>
        <mj-text align="center" font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 10px">
          BIRMINGHAM &middot; FRESHLY PREPARED, DAILY
        </mj-text>
        <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-weight="bold" font-size="34px" color="#1b2a0c" padding="0">
          OlivePinch
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 32px 24px">
      <mj-column>
        <mj-divider border-width="2px" border-color="#646e38" width="56px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Card -->
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="40px 36px">

      <mj-section>
        <mj-column>
          <mj-text font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 14px">
            PLAN ENDING SOON
          </mj-text>
          <!-- Deliberately smaller than the other emails' headlines so the date panel below
               stays the largest thing on the page — the deadline is the message. -->
          <mj-text css-class="email-heading" font-family="Georgia, 'Times New Roman', serif" font-weight="bold" font-size="26px" line-height="1.25" color="#272c0f" padding="0 0 12px">
            Your meals stop on {{endDate}}, {{name}}.
          </mj-text>
          <mj-text padding="0 0 24px" color="#4b4b3f">
            Your {{planDuration}}-day plan runs out then. Renew before it does and your deliveries carry on without a gap &mdash; same goal, same kitchen, no restart.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Date panel: the hero. Pale coral marks this as the one time-pressured email. -->
      <mj-section background-color="#fbeee7" border-radius="12px" padding="26px 22px">
        <mj-column>
          <mj-text align="center" font-size="10px" letter-spacing="2px" color="#a53e21" font-weight="bold" padding="0 0 10px">
            LAST DELIVERY
          </mj-text>
          <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-weight="bold" font-size="34px" line-height="1.15" color="#272c0f" padding="0">
            {{endDate}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="28px 0 0">
        <mj-column>
          <mj-button background-color="#c9502c" color="#ffffff" font-size="14px" font-weight="bold" border-radius="999px" padding="0 0 16px" inner-padding="16px 34px" href="{{dashboardUrl}}">
            Renew my plan
          </mj-button>
          <mj-text align="center" font-size="13px" color="#6b6b5f" padding="0">
            Changing your goal or meal count? You can adjust it as you renew.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Footer -->
    <mj-section padding="32px 36px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e6dfcd" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section padding="20px 24px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8a8a78" padding="0 0 12px">
          OlivePinch &middot; Birmingham, UK<br />
          Questions? Just reply to this email.
        </mj-text>
        <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="13px" color="#a09c85" padding="0">
          Hand-delivered across Birmingham.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
