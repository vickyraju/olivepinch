<mjml lang="en">

  <mj-head>
    <mj-title>Your OlivePinch login code</mj-title>
    <mj-preview>Your login code is {{ .Token }}. It expires in 1 hour.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#272c0f" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>

  <mj-body background-color="#f7f4ec" width="600px">

    <!-- Masthead -->
    <mj-section padding="40px 32px 12px">
      <mj-column>
        <mj-text align="center" font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 10px">
          BIRMINGHAM &middot; FRESHLY PREPARED, DAILY
        </mj-text>
        <mj-image src="https://olivepinch.vercel.app/email/logo.png" alt="OlivePinch" title="OlivePinch" width="200px" align="center" padding="0" href="https://olivepinch.vercel.app" />
      </mj-column>
    </mj-section>

    <mj-section padding="0 32px 24px">
      <mj-column>
        <mj-divider border-width="2px" border-color="#646e38" width="56px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Card. Supabase fills in {{ .Token }}: this one template serves both the "Magic link or OTP"
         and "Confirm sign up" emails, so first-time and returning customers get the same email. -->
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="40px 36px">

      <mj-section>
        <mj-column>
          <mj-text font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 14px">
            YOUR LOGIN CODE
          </mj-text>
          <mj-text css-class="email-heading" font-family="Georgia, 'Times New Roman', serif" font-weight="bold" font-size="26px" line-height="1.25" color="#272c0f" padding="0 0 12px">
            Here's your code to log in.
          </mj-text>
          <mj-text padding="0 0 24px" color="#4b4b3f">
            Enter this code on the OlivePinch login page to get to your meals, deliveries and plan.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- The code is the hero: large, spaced so digits can't be misread, in its own panel. -->
      <mj-section background-color="#f0f4e6" border-radius="12px" padding="26px 18px">
        <mj-column>
          <mj-text align="center" font-size="10px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 10px">
            6-DIGIT CODE
          </mj-text>
          <mj-text align="center" font-family="'Courier New', Courier, monospace" font-size="40px" line-height="1.1" font-weight="bold" letter-spacing="10px" color="#1b2a0c" padding="0 0 0 10px">
            {{ .Token }}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="20px 0 0">
        <mj-column>
          <mj-text align="center" font-size="14px" color="#4b4b3f" padding="0 0 6px">
            This code works once and expires in <strong>1 hour</strong>.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Security note, set apart so it's read. -->
      <mj-section background-color="#fbeee7" border-radius="12px" padding="16px 18px" css-class="security-note">
        <mj-column>
          <mj-text font-size="13px" color="#4b4b3f">
            <strong style="color:#a53e21;">Didn't ask for this?</strong> You can ignore this email &mdash; nobody can log in without the code. And never share it, not even with us: we'll never ask for it.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Footer -->
    <mj-section padding="32px 36px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e6dfcd" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section padding="20px 24px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8a8a78" padding="0 0 12px">
          OlivePinch &middot; Birmingham, UK<br />
          Questions? Email <a href="mailto:hello@olivepinch.com" style="color:#646e38;">hello@olivepinch.com</a>
        </mj-text>
        <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="13px" color="#a09c85" padding="0">
          Hand-delivered across Birmingham.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
