<mjml lang="en">
  <mj-head>
    <mj-title>Next week's menu is open — choose your meals</mj-title>
    <mj-preview>Pick what you'd like for the week of {{weekStart}}, or we'll match your goal for you.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#272c0f" font-size="15px" line-height="1.6" padding="0" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-html-attributes>
      <mj-selector path=".email-heading div">
        <mj-html-attribute name="role">heading</mj-html-attribute>
        <mj-html-attribute name="aria-level">1</mj-html-attribute>
      </mj-selector>
    </mj-html-attributes>
  </mj-head>
  <mj-body background-color="#f7f4ec" width="600px">

    <!-- Masthead -->
    <mj-section padding="40px 32px 12px">
      <mj-column>
        <mj-text align="center" font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 10px">
          BIRMINGHAM &middot; FRESHLY PREPARED, DAILY
        </mj-text>
        <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-weight="bold" font-size="34px" color="#1b2a0c" padding="0">
          OlivePinch
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 32px 24px">
      <mj-column>
        <mj-divider border-width="2px" border-color="#646e38" width="56px" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Card -->
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="40px 36px">

      <mj-section>
        <mj-column>
          <mj-text font-size="11px" letter-spacing="2px" color="#646e38" font-weight="bold" padding="0 0 14px">
            NEXT WEEK'S MENU
          </mj-text>
          <mj-text css-class="email-heading" font-family="Georgia, 'Times New Roman', serif" font-weight="bold" font-size="28px" line-height="1.25" color="#272c0f" padding="0 0 12px">
            Choose next week's meals, {{name}}.
          </mj-text>
          <mj-text padding="0 0 24px" color="#4b4b3f">
            The menu for the week of {{weekStart}} is now open. Pick what you'd like for each delivery day &mdash; it takes a couple of minutes.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Deadline panel: coral like the renewal reminder, but at half the type size. Missing
           this deadline isn't a failure state (the fallback below is a real one), so it must
           not read with the same alarm as a plan about to lapse. -->
      <mj-section background-color="#fbeee7" border-radius="12px" padding="20px 22px">
        <mj-column>
          <mj-text align="center" font-size="10px" letter-spacing="2px" color="#a53e21" font-weight="bold" padding="0 0 8px">
            CHOOSE BY
          </mj-text>
          <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-weight="bold" font-size="24px" line-height="1.2" color="#272c0f" padding="0">
            {{cutoffDate}}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="28px 0 0">
        <mj-column>
          <mj-button background-color="#c9502c" color="#ffffff" font-size="14px" font-weight="bold" border-radius="999px" padding="0 0 16px" inner-padding="14px 30px" href="{{dashboardUrl}}">
            Choose my meals
          </mj-button>
          <mj-text align="center" font-size="13px" color="#6b6b5f" padding="0">
            Don't fancy choosing? Leave it with us &mdash; we'll match your meals to your goal automatically.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Footer -->
    <mj-section padding="32px 36px 0">
      <mj-column>
        <mj-divider border-width="1px" border-color="#e6dfcd" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section padding="20px 24px 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#8a8a78" padding="0 0 12px">
          OlivePinch &middot; Birmingham, UK<br />
          Questions? Just reply to this email.
        </mj-text>
        <mj-text align="center" font-family="Georgia, 'Times New Roman', serif" font-style="italic" font-size="13px" color="#a09c85" padding="0">
          Hand-delivered across Birmingham.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
