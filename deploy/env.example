# /opt/olivepinch/.env on the server (chmod 600). Never commit real values.
DATABASE_URL="postgresql://olivepinch:DB_PASSWORD@localhost:5432/olivepinch?connection_limit=5"
PORT=4000
JWT_SECRET=            # long random string: openssl rand -hex 48
CRON_SECRET=           # long random string
CORS_ORIGIN="https://www.olivepinch.com,https://admin.olivepinch.com"
APP_URL="https://www.olivepinch.com"
BETTER_AUTH_SECRET=    # openssl rand -hex 32
BETTER_AUTH_URL="https://api.olivepinch.com"
AUTH_COOKIE_DOMAIN="olivepinch.com"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPLOAD_DIR="/var/www/olivepinch/uploads"
UPLOADS_PUBLIC_URL="https://api.olivepinch.com/uploads"
WORLDPAY_USERNAME=     # live credentials only
WORLDPAY_PASSWORD=
WORLDPAY_ENTITY=
WORLDPAY_API_URL="https://access.worldpay.com"
RESEND_API_KEY=
EMAIL_FROM=
# RCLONE_REMOTE="b2:olivepinch-backups"
