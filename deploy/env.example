# /opt/olivepinch/.env on the server (chmod 600). Never commit real values.
DATABASE_URL="postgresql://olivepinch:DB_PASSWORD@localhost:5432/olivepinch?connection_limit=5"
PORT=4000
JWT_SECRET=            # long random string: openssl rand -hex 48
CRON_SECRET=           # long random string
CORS_ORIGIN="https://DOMAIN,https://ADMIN_DOMAIN"
APP_URL="https://DOMAIN"
SUPABASE_URL=          # keep while login stays on Supabase
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORLDPAY_USERNAME=     # live credentials only
WORLDPAY_PASSWORD=
WORLDPAY_ENTITY=
WORLDPAY_API_URL="https://access.worldpay.com"
RESEND_API_KEY=
EMAIL_FROM=
