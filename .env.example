# Optional — defaults to http://localhost:4000/api if unset
VITE_API_URL=

# Required — customer auth (phone OTP) via Firebase. Get these from the Firebase
# console under Project Settings > General > Your apps > Web app — all four are
# safe to expose in the browser bundle, that's what they're for.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
