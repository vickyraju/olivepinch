# Optional — defaults to http://localhost:4000/api if unset
VITE_API_URL=

# Required — customer auth (email OTP + Google sign-in) via Supabase. Get these from the
# Supabase dashboard under Project Settings > API — both are safe to expose in the browser
# bundle (the anon key relies on RLS/backend checks, not secrecy). Same project as the
# backend's DATABASE_URL/SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
