# Optional — defaults to http://localhost:4000/api if unset
VITE_API_URL=

# Required — customer auth (email OTP + Google/Apple sign-in) via Supabase Auth.
# Same project as the backend's SUPABASE_URL. Find both in the Supabase dashboard
# under Project Settings > API — the anon/publishable key is safe to expose in the
# browser bundle, that's what it's for.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
